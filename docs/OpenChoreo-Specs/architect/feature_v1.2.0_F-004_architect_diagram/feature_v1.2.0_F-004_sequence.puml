@startuml feature_v1.2.0_F-004_sequence
' Runtime truth for F-004 v1.2.0 — Authorization and Access Control
' Reconstructed from shipped code. Arrows name contracts the hub documents;
' a value not configured anywhere in the repository is written OPEN, never guessed.
' The cast below is the participants: list of feature_v1.2.0_F-004_front-matter.yaml, name for name.
title F-004 v1.2.0 — Authorization and Access Control
autonumber

actor "Subject" as Actor
actor "Platform engineer" as PE
participant "openchoreo-api" as API
participant "JWT middleware" as JWT
participant "authz checker" as Chk
participant "Casbin PDP" as PDP
participant "Casbin enforcer" as Enf
participant "authz watchers" as Watch
database "Kubernetes API (etcd)" as K8s
participant "admission webhook" as WH

group F-004-US1 — grant a team rights over exactly one project
  PE -> API : POST /api/v1/namespaces/{namespaceName}/authzrolebindings
  activate API
  API -> WH : admission review
  activate WH
  WH -> WH : validate target scope
  alt Component and Resource both set
    WH --> API : rejected
    API --> PE : rejected; the binding is never stored
  else valid
    WH --> API : admitted
    API -> K8s : create AuthzRoleBinding
  end
  deactivate WH
  deactivate API
  K8s -> Watch : watch event
  Watch -> Enf : add grouping and policy rules
  note right of Watch : this family is watched into the enforcer, not reconciled toward a desired state
end

group F-004-US2 — ask the platform what I am allowed to do before trying
  Actor -> API : GET /api/v1/authz/profile
  activate API
  API -> PDP : GetSubjectProfile
  PDP -> Enf : filter policies by subject and scope
  Enf --> PDP : policies
  PDP --> API : capabilities
  API --> Actor : capabilities
  deactivate API
  Actor -> API : POST /api/v1/authz/evaluates
  API -> PDP : BatchEvaluate
  PDP --> API : decisions
end

group F-004-US3 — every request is checked at the boundary
  Actor -> API : any operation
  activate API
  API -> JWT : authenticate
  JWT -> Chk : authorize
  Chk -> PDP : Evaluate(request context)
  PDP -> PDP : serialise the request context once, reuse across entitlements
  PDP -> Enf : enforce
  Enf --> PDP : allow or deny
  PDP --> Chk : decision
  alt denied
    Chk --> Actor : denied
  else allowed
    Chk --> API : proceed
  end
  deactivate API
end

group failure — a malformed policy entry
  Watch -> Enf : load policy from the custom resource
  Enf --> Watch : parse error on one entry
  Watch -> Watch : the whole custom resource is rejected, sibling entries are not trusted
  note right of Watch : fail closed
end

group failure — removing a rule that was never present
  Watch -> Enf : RemoveGroupingPolicy
  Enf --> Watch : (false, nil)
  Watch -> Watch : no-op, logged at debug
end

group failure — deletion while dependents exist
  PE -> API : DELETE the role or binding
  API -> K8s : delete
  K8s -> Watch : deletion event
  Watch -> Enf : remove the grouping and policy rules
end

note over PDP, Enf
  invariants: DOM-002-R1 a hierarchy must not set both Component and Resource
  DOM-002-R2 a malformed entry poisons the whole custom resource, fail closed
  DOM-002-R3 removing an absent rule is a no-op
  DOM-002-R4 the request context is serialised once per request
  DOM-002-R5 exec and wirelogs authenticate outside the standard middleware order
  OPEN: no timeout or retry is configured on the decision path
  OPEN: nothing reports drift between enforcer state and the custom resources
end note
@enduml
